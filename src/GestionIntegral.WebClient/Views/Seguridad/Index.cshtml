@{
    ViewData["Title"] = "Seguridad";
}

<partial name="_Alerts" />

<div class="row">
    <div class="col-auto">
        <div class="small-box bg-info">
            <div class="inner">
                <h3>&nbsp;</h3>
                <p>Usuarios</p>
            </div>
            <div class="icon">
                <i class="fas fa-users"></i>
            </div>
            <a asp-controller="Usuarios" asp-action="Index" class="small-box-footer">Administrar <i class="fas fa-arrow-circle-right ml-1"></i></a>
        </div>
    </div>

    <div class="col-auto">
        <div class="small-box bg-warning">
            <div class="inner">
                <h3>&nbsp;</h3>
                <p>Tipos de Usuario</p>
            </div>
            <div class="icon">
                <i class="fas fa-user-tag"></i>
            </div>
            <a asp-controller="TiposUsuario" asp-action="Index" class="small-box-footer">Administrar <i class="fas fa-arrow-circle-right ml-1"></i></a>
        </div>
    </div>
</div>
