@{
    ViewData["Title"] = "Seguridad";
}

<partial name="_Alerts" />

<div class="row">
    <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
        <div class="small-box">
            <div class="inner">
                <h3>Usuarios</h3>
            </div>
            <a asp-controller="Usuarios" asp-action="Index" class="small-box-footer">
                Administrar <i class="fas fa-users tarjeta-icono-footer"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
        <div class="small-box">
            <div class="inner">
                <h3>Tipos de Usuario</h3>
            </div>
            <a asp-controller="TiposUsuario" asp-action="Index" class="small-box-footer">
                Administrar <i class="fas fa-user-tag tarjeta-icono-footer"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
        <div class="small-box">
            <div class="inner">
                <h3>Clientes</h3>
            </div>
            <a asp-controller="Clientes" asp-action="Index" class="small-box-footer">
                Administrar <i class="fas fa-user-friends tarjeta-icono-footer"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
        <div class="small-box">
            <div class="inner">
                <h3>Proveedores</h3>
            </div>
            <a asp-controller="Proveedores" asp-action="Index" class="small-box-footer">
                Administrar <i class="fas fa-truck tarjeta-icono-footer"></i>
            </a>
        </div>
    </div>
</div>
