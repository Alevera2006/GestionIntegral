@{
    ViewData["Title"] = "Valores en Cartera";
}

<partial name="_Alerts" />

<div class="card">
    <div class="card-header bg-warning">
        <h3 class="card-title"><i class="fas fa-money-check-alt mr-2"></i> Valores en Cartera</h3>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-4">
                <input type="text" id="vcFiltro" class="form-control" placeholder="Buscar por cliente, número o banco" />
            </div>
            <div class="col-md-3">
                <select id="vcFiltroEstado" class="form-control">
                    <option value="">Todos los estados</option>
                    <option value="Cartera">Cartera</option>
                    <option value="Depositado">Depositado</option>
                    <option value="EntregadoProveedor">Entregado a Proveedor</option>
                    <option value="Acreditado">Acreditado</option>
                </select>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-striped table-hover" id="valoresCarteraTable">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Tipo</th>
                        <th>Número</th>
                        <th>Banco</th>
                        <th>Emisión</th>
                        <th>Vencimiento</th>
                        <th>Importe</th>
                        <th>Estado</th>
                        <th>Observaciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/views/valorescartera.index.js" asp-append-version="true"></script>
}
