@{
    ViewData["Title"] = "Proveedores";
}

<partial name="_Alerts" />

<div class="card">
    <div class="card-header bg-success">
        <h3 class="card-title"><i class="fas fa-truck mr-2"></i> Proveedores</h3>
    </div>
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-end mb-3">
            <div class="form-group mb-2 flex-grow-1 mr-2" style="min-width: 220px;">
                <label for="proveedorFiltro">Filtrar proveedores</label>
                <input type="text" id="proveedorFiltro" class="form-control" placeholder="Buscar por código, razón social, CUIT o condición" />
            </div>
            <button type="button" id="btnNuevoProveedor" class="btn btn-success mb-2">
                <i class="fas fa-plus mr-1"></i> Nuevo
            </button>
        </div>

        <div class="table-responsive" style="max-height: 420px; overflow-y: auto;">
            <table class="table table-sm table-striped table-hover mb-0" id="proveedorTable">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Razón Social</th>
                        <th>CUIT</th>
                        <th>Condición</th>
                        <th>Activo</th>
                        <th class="table-actions">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="proveedorFormModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success">
                <h5 class="modal-title" id="proveedorFormTitle">Nuevo Proveedor</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span>&times;</span></button>
            </div>
            <form id="proveedorForm" autocomplete="off">
                @Html.AntiForgeryToken()
                <input type="hidden" id="proveedorId" />
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-4 form-group">
                            <label for="proveedorCodigo">Código</label>
                            <input type="text" id="proveedorCodigo" class="form-control" maxlength="20" required />
                        </div>
                        <div class="col-md-8 form-group">
                            <label for="proveedorRazonSocial">Razón Social</label>
                            <input type="text" id="proveedorRazonSocial" class="form-control" maxlength="150" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label for="proveedorNombreFantasia">Nombre Fantasía</label>
                            <input type="text" id="proveedorNombreFantasia" class="form-control" maxlength="150" />
                        </div>
                        <div class="col-md-6 form-group">
                            <label for="proveedorCuit">CUIT</label>
                            <input type="text" id="proveedorCuit" class="form-control" maxlength="13" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label for="proveedorCondicionPago">Condición de Pago</label>
                            <select id="proveedorCondicionPago" class="form-control"></select>
                        </div>
                        <div class="col-md-6 form-group">
                            <label for="proveedorObservaciones">Observaciones</label>
                            <textarea id="proveedorObservaciones" class="form-control" rows="2" maxlength="500"></textarea>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 form-group d-flex align-items-end">
                            <div class="icheck-primary d-inline">
                                <input type="checkbox" id="proveedorActivo" checked />
                                <label for="proveedorActivo">Activo</label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group mb-0" id="proveedorContactButtons" style="display: none;">
                        <button type="button" id="btnProveedorDomicilios" class="btn btn-outline-info btn-sm mr-1 btn-domicilios" data-id="0" disabled>
                            <i class="fas fa-map-marker-alt mr-1"></i> Domicilios
                        </button>
                        <button type="button" id="btnProveedorTelefonos" class="btn btn-outline-secondary btn-sm mr-1 btn-telefonos" data-id="0" disabled>
                            <i class="fas fa-phone mr-1"></i> Teléfonos
                        </button>
                        <button type="button" id="btnProveedorEmails" class="btn btn-outline-warning btn-sm btn-emails" data-id="0" disabled>
                            <i class="fas fa-envelope mr-1"></i> Emails
                        </button>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success"><i class="fas fa-save mr-1"></i> Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="proveedorDomiciliosModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info">
                <h5 class="modal-title">Domicilios del Proveedor</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="domProveedorId" />
                <input type="hidden" id="domProvId" />

                <div class="row">
                    <div class="col-md-6 form-group">
                        <label for="domProvDomicilio">Domicilio</label>
                        <input type="text" id="domProvDomicilio" class="form-control" maxlength="250" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label for="domProvCiudad">Ciudad</label>
                        <input type="text" id="domProvCiudad" class="form-control" maxlength="100" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label for="domProvLocalidad">Localidad</label>
                        <input type="text" id="domProvLocalidad" class="form-control" maxlength="100" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group">
                        <label for="domProvProvincia">Provincia</label>
                        <select id="domProvProvincia" class="form-control"></select>
                    </div>
                    <div class="col-md-3 form-group">
                        <label for="domProvCodigoPostal">Código Postal</label>
                        <input type="text" id="domProvCodigoPostal" class="form-control" maxlength="20" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end form-group">
                        <button type="button" id="btnGuardarDomicilioProv" class="btn btn-info btn-block">Guardar domicilio</button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm table-striped" id="domiciliosProveedorTable">
                        <thead>
                            <tr>
                                <th>Domicilio</th>
                                <th>Ciudad</th>
                                <th>Provincia</th>
                                <th>CP</th>
                                <th class="table-actions">Acciones</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="proveedorTelefonosModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-secondary">
                <h5 class="modal-title">Teléfonos del Proveedor</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="telProveedorId" />
                <input type="hidden" id="telProvId" />

                <div class="row">
                    <div class="col-md-6 form-group">
                        <label for="telProvNumero">Número</label>
                        <input type="text" id="telProvNumero" class="form-control" maxlength="50" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label for="telProvTipo">Tipo</label>
                        <select id="telProvTipo" class="form-control">
                            <option value="Fijo">Fijo</option>
                            <option value="Celular">Celular</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex align-items-end form-group">
                        <button type="button" id="btnGuardarTelefonoProv" class="btn btn-secondary btn-block">Guardar teléfono</button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm table-striped" id="telefonosProveedorTable">
                        <thead>
                            <tr>
                                <th>Número</th>
                                <th>Tipo</th>
                                <th class="table-actions">Acciones</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="proveedorEmailsModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title">Emails del Proveedor</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="emailProveedorId" />
                <input type="hidden" id="emailProvId" />

                <div class="row">
                    <div class="col-md-9 form-group">
                        <label for="emailProvValor">Email</label>
                        <input type="email" id="emailProvValor" class="form-control" maxlength="254" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end form-group">
                        <button type="button" id="btnGuardarEmailProv" class="btn btn-warning btn-block">Guardar email</button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm table-striped" id="emailsProveedorTable">
                        <thead>
                            <tr>
                                <th>Email</th>
                                <th class="table-actions">Acciones</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/views/proveedores.index.js" asp-append-version="true"></script>
}
