@model IEnumerable<GestionIntegral.WebClient.Models.Parametros.TarjetaParametroViewModel>
@{
    ViewData["Title"] = "Parámetros";
}

<partial name="_Alerts" />

<div class="row">
    @foreach (var tarjeta in Model)
    {
        <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
            <div class="small-box tarjeta-parametro" data-key="@tarjeta.Key" data-api-url="@tarjeta.ApiUrl" data-requiere-afip="@tarjeta.RequiereCodigoAFIP.ToString().ToLower()">
                <div class="inner">
                    <h3>@tarjeta.Titulo</h3>
                </div>
                <div class="icon">
                    <i class="fas @tarjeta.Icono"></i>
                </div>
                <button type="button" class="small-box-footer btn-administrar" data-key="@tarjeta.Key">
                    Administrar <i class="fas fa-arrow-circle-right ml-1"></i>
                </button>
            </div>
        </div>
    }
</div>

<!-- Modal genérico de administración de parámetros -->
<div class="modal fade" id="parametroModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header" id="parametroModalHeader">
                <h5 class="modal-title" id="parametroModalTitle">Administrar</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-end mb-3">
                    <div class="form-group mb-0">
                        <label for="parametroFiltroActivo">Estado</label>
                        <select id="parametroFiltroActivo" class="form-control">
                            <option value="todos">Todos</option>
                            <option value="activos">Activos</option>
                            <option value="inactivos">Inactivos</option>
                        </select>
                    </div>
                    <button type="button" id="btnNuevoParametro" class="btn btn-primary">
                        <i class="fas fa-plus mr-1"></i> Nuevo
                    </button>
                </div>
                <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                    <table class="table table-sm table-striped table-hover mb-0" id="parametroTable">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Descripción</th>
                                <th class="col-afip" style="display: none;">AFIP</th>
                                <th>Activo</th>
                                <th class="table-actions">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Alta y edición de parámetros -->
<div class="modal fade" id="parametroFormModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="parametroFormTitle">Nuevo parámetro</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="parametroForm" autocomplete="off">
                @Html.AntiForgeryToken()
                <input type="hidden" id="parametroId" />
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-4 form-group">
                            <label for="parametroCodigo">Código</label>
                            <input type="text" id="parametroCodigo" class="form-control" maxlength="20" required />
                        </div>
                        <div class="col-md-8 form-group">
                            <label for="parametroDescripcion">Descripción</label>
                            <input type="text" id="parametroDescripcion" class="form-control" maxlength="100" required />
                        </div>
                    </div>
                    <div class="row" id="parametroCodigoAFIPRow" style="display: none;">
                        <div class="col-md-6 form-group">
                            <label for="parametroCodigoAFIP">Código AFIP</label>
                            <input type="text" id="parametroCodigoAFIP" class="form-control" maxlength="50" />
                        </div>
                    </div>
                    <div class="form-group mb-0">
                        <div class="icheck-primary d-inline">
                            <input type="checkbox" id="parametroActivo" checked />
                            <label for="parametroActivo">Activo</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/views/parametros.index.js" asp-append-version="true"></script>
}
