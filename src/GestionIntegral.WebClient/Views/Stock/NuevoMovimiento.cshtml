@{
    ViewData["Title"] = "Nuevo Movimiento de Stock";
    var depositos = ViewBag.Depositos as List<GestionIntegral.WebClient.Models.Stock.DepositoResponseDto> ?? new();
    var tipos = ViewBag.TiposMovimiento as List<GestionIntegral.WebClient.Models.Stock.TipoMovimientoStockResponseDto> ?? new();
    var usuarios = ViewBag.Usuarios as List<GestionIntegral.WebClient.Models.Usuarios.UsuarioResponseDto> ?? new();
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-plus-circle mr-2"></i> Nuevo Movimiento de Stock</h3>
    </div>
    <div class="card-body">
        <form id="movimientoForm">
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="idDeposito">Depósito <span class="text-danger">*</span></label>
                        <select id="idDeposito" class="form-control" required>
                            <option value="">Seleccione</option>
                            @foreach (var dep in depositos)
                            {
                                <option value="@dep.IdDeposito">@dep.Descripcion</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="idTipoMovimientoStock">Tipo de Movimiento <span class="text-danger">*</span></label>
                        <select id="idTipoMovimientoStock" class="form-control" required>
                            <option value="">Seleccione</option>
                            @foreach (var tipo in tipos)
                            {
                                <option value="@tipo.IdTipoMovimientoStock" data-signo="@tipo.Signo">@tipo.Descripcion</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="idUsuarioResponsable">Responsable <span class="text-danger">*</span></label>
                        <select id="idUsuarioResponsable" class="form-control" required>
                            <option value="">Seleccione</option>
                            @foreach (var usr in usuarios)
                            {
                                <option value="@usr.IdUsuario">@usr.Nombre @usr.Apellido</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="referencia">Referencia</label>
                        <input type="text" id="referencia" class="form-control" maxlength="100" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="form-group">
                        <label for="observaciones">Observaciones</label>
                        <textarea id="observaciones" class="form-control" rows="2" maxlength="500"></textarea>
                    </div>
                </div>
            </div>

            <hr />

            <h5>Productos</h5>
            <div class="row mb-3">
                <div class="col-md-8">
                    <div class="form-group mb-0">
                        <label for="busquedaProducto">Buscar producto</label>
                        <div class="input-group">
                            <input type="text" id="busquedaProducto" class="form-control" placeholder="Código o descripción" />
                            <div class="input-group-append">
                                <button type="button" id="btnBuscarProducto" class="btn btn-outline-secondary">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="button" id="btnAgregarProducto" class="btn btn-primary" disabled>
                        <i class="fas fa-plus mr-1"></i> Agregar Producto
                    </button>
                </div>
            </div>

            <div class="form-group">
                <select id="resultadosProducto" class="form-control" size="5" style="display: none;"></select>
            </div>

            <div class="table-responsive">
                <table class="table table-sm table-striped" id="detallesTable">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th class="text-right" style="width: 150px;">Cantidad</th>
                            <th class="table-actions" style="width: 80px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="sin-detalles">
                            <td colspan="3" class="text-center text-muted">Agregue al menos un producto.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a href="/Stock/Movimientos" class="btn btn-secondary">
                    <i class="fas fa-arrow-left mr-1"></i> Volver
                </a>
                <button type="submit" class="btn btn-success" id="btnGuardarMovimiento" disabled>
                    <i class="fas fa-save mr-1"></i> Guardar Movimiento
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/views/stock.nuevomovimiento.js" asp-append-version="true"></script>
}
