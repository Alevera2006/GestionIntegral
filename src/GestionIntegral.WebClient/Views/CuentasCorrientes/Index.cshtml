@{
    ViewData["Title"] = "Cuentas Corrientes";
}

<partial name="_Alerts" />

<div class="card">
    <div class="card-header bg-info">
        <h3 class="card-title"><i class="fas fa-book mr-2"></i> Cuentas Corrientes de Clientes</h3>
    </div>
    <div class="card-body">
        <div class="form-group">
            <label for="ccFiltro">Buscar cliente</label>
            <input type="text" id="ccFiltro" class="form-control" placeholder="Código, razón social o CUIT" />
        </div>

        <div class="table-responsive" style="max-height: 420px; overflow-y: auto;">
            <table class="table table-sm table-striped table-hover" id="clientesCcTable">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th class="text-right">Saldo</th>
                        <th class="table-actions">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="movimientosModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info">
                <h5 class="modal-title" id="movimientosTitulo">Movimientos</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 id="ccSaldoActual" class="mb-0">Saldo: $ 0,00</h5>
                    <button type="button" id="btnNuevoPago" class="btn btn-success"><i class="fas fa-plus mr-1"></i> Registrar Pago</button>
                </div>

                <div class="table-responsive" style="max-height: 420px; overflow-y: auto;">
                    <table class="table table-sm table-striped table-hover" id="movimientosTable">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Concepto</th>
                                <th>Comprobante</th>
                                <th class="text-right">Debe</th>
                                <th class="text-right">Haber</th>
                                <th class="text-right">Saldo</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="pagoModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success">
                <h5 class="modal-title">Registrar Pago</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span>&times;</span></button>
            </div>
            <form id="pagoForm" autocomplete="off">
                @Html.AntiForgeryToken()
                <input type="hidden" id="pagoIdCliente" />
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-4 form-group">
                            <label for="pagoFecha">Fecha</label>
                            <input type="date" id="pagoFecha" class="form-control" required />
                        </div>
                        <div class="col-md-4 form-group">
                            <label for="pagoMonto">Monto</label>
                            <input type="number" id="pagoMonto" class="form-control" min="0.01" step="0.01" required />
                        </div>
                        <div class="col-md-4 form-group">
                            <label for="pagoMedioPago">Medio de Pago</label>
                            <select id="pagoMedioPago" class="form-control" required></select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label for="pagoFactura">Aplicar a factura (opcional)</label>
                            <select id="pagoFactura" class="form-control"></select>
                        </div>
                        <div class="col-md-6 form-group">
                            <label for="pagoObservaciones">Observaciones</label>
                            <input type="text" id="pagoObservaciones" class="form-control" maxlength="250" />
                        </div>
                    </div>
                    <div id="chequeFields" style="display: none;">
                        <div class="row">
                            <div class="col-md-4 form-group">
                                <label for="pagoNumeroCheque">Número de Cheque</label>
                                <input type="text" id="pagoNumeroCheque" class="form-control" maxlength="50" />
                            </div>
                            <div class="col-md-4 form-group">
                                <label for="pagoBanco">Banco</label>
                                <input type="text" id="pagoBanco" class="form-control" maxlength="100" />
                            </div>
                            <div class="col-md-4 form-group">
                                <label for="pagoFechaVencimientoCheque">Fecha Vencimiento</label>
                                <input type="date" id="pagoFechaVencimientoCheque" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success"><i class="fas fa-save mr-1"></i> Guardar Pago</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/views/cuentascorrientes.index.js" asp-append-version="true"></script>
}
